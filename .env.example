# Tamable: Settings › Sites › your site
NUXT_TAMABLE_API_URL=https://api.tamable.app/api/v1
NUXT_TAMABLE_READ_KEY=
NUXT_TAMABLE_WEBHOOK_SECRET=
# Your host's build hook (Forge, Netlify, Vercel, Cloudflare Pages...), called on each content change
NUXT_DEPLOY_HOOK_URL=
# The canonical address, with no trailing slash
NUXT_PUBLIC_SITE_URL=https://example.com
